---
import { siteContent } from '../../config/siteContent';
import SectionTitle from '../ui/SectionTitle.astro';
import Button from '../ui/Button.astro';
---

<section
  id='lokasi'
  class='py-20 bg-white'>
  <div class='max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-12 items-center'>
    <div class='text-left'>
      <SectionTitle
        subtitle='KUNJUNGI KAMI'
        title='Lokasi & Kontak'
        align='left'
      />
      <p class='text-muted mb-8 text-lg'>
        Silakan datang langsung ke toko kami untuk transaksi tatap muka yang
        lebih aman dan terpercaya.
      </p>

      <div class='flex flex-col gap-6 mb-8'>
        <div
          class='flex items-start gap-4 p-6 bg-background rounded-xl border border-gray-100'>
          <div
            class='w-12 h-12 bg-primary/10 text-primary rounded-lg flex items-center justify-center shrink-0'>
            <svg
              class='w-6 h-6'
              fill='none'
              stroke='currentColor'
              viewBox='0 0 24 24'
              ><path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z'
              ></path><path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M15 11a3 3 0 11-6 0 3 3 0 016 0z'
              ></path></svg
            >
          </div>
          <div>
            <h4 class='font-bold text-tertiary mb-1'>Alamat Toko</h4>
            <p class='text-muted text-sm'>{siteContent.contact.address}</p>
          </div>
        </div>

        <div
          class='flex items-start gap-4 p-6 bg-background rounded-xl border border-gray-100'>
          <div
            class='w-12 h-12 bg-accent/10 text-accent rounded-lg flex items-center justify-center shrink-0'>
            <svg
              class='w-6 h-6'
              fill='currentColor'
              viewBox='0 0 24 24'
              ><path
                d='M12.031 0C5.385 0 0 5.385 0 12.031c0 2.115.551 4.176 1.597 5.986L.048 24l6.155-1.547c1.748.966 3.738 1.474 5.828 1.474 6.646 0 12.031-5.385 12.031-12.031S18.677 0 12.031 0zm0 21.979c-1.802 0-3.565-.483-5.111-1.399l-.367-.217-3.805.955.972-3.712-.238-.379C2.519 15.656 2 13.882 2 12.031 2 6.49 6.49 2 12.031 2s10.031 4.49 10.031 10.031-4.49 10.031-10.031 10.031z'
              ></path></svg
            >
          </div>
          <div>
            <h4 class='font-bold text-tertiary mb-1'>WhatsApp Aktif</h4>
            <p class='text-muted text-sm font-semibold'>
              {siteContent.contact.phone}
            </p>
          </div>
        </div>
      </div>

      <Button
        text='Chat WhatsApp Sekarang'
        variant='primary'
      />
    </div>

    <!-- MapBox -->
    <div
      class='h-[400px] lg:h-[500px] w-full rounded-2xl overflow-hidden shadow-lg border border-gray-100 bg-gray-50'>
      <iframe
        src='https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3960.9161747808264!2d107.6449174!3d-6.9005917!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e68e7b99c756fbd%3A0xc621b1d83507c6f0!2sJl.%20Sulaksana%2C%20Cicaheum%2C%20Kec.%20Kiaracondong%2C%20Kota%20Bandung%2C%20Jawa%20Barat!5e0!3m2!1sid!2sid!4v1700000000000!5m2!1sid!2sid'
        width='100%'
        height='100%'
        style='border:0;'
        allowfullscreen=''
        loading='lazy'
        referrerpolicy='no-referrer-when-downgrade'
        title='Lokasi GestunByAisyah'
      ></iframe>
    </div>
  </div>
</section>
