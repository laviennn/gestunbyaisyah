---
import { siteContent } from '../../config/siteContent';

// Kita memisahkan paragraf description jika memungkinkan agar rapi seperti di gambar
const descParagraphs = siteContent.tentang.description
  .split('. ')
  .map((p) => p + (p.endsWith('.') ? '' : '.'));
---

<section
  id='tentang-kami'
  class='py-24 bg-tertiary relative overflow-hidden'>
  <div
    class='max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16 lg:gap-12 items-start'>
    <div class='flex flex-col gap-6 text-left'>
      <div>
        <span
          class='text-primary font-bold text-[11px] tracking-[0.15em] uppercase block mb-3'>
          {siteContent.tentang.subtitle}
        </span>
        <h2 class='text-3xl md:text-4xl font-extrabold text-white'>
          {siteContent.tentang.title}
        </h2>
      </div>

      <div
        class='flex flex-col gap-4 text-[15px] text-gray-300 leading-relaxed'>
        <p>{descParagraphs[0]}</p>
        {
          descParagraphs.length > 1 && (
            <p>{descParagraphs.slice(1).join(' ')}</p>
          )
        }
      </div>

      <div
        class='mt-4 bg-white/[0.03] border border-white/10 rounded-2xl p-6 md:p-8'>
        <h3 class='text-lg font-bold text-white mb-5'>
          Informasi Penting (Disclaimer)
        </h3>
        <ul class='flex flex-col gap-4'>
          {
            siteContent.tentang.bullets.map((bullet) => (
              <li class='flex items-start gap-3'>
                <svg
                  class='w-5 h-5 text-primary shrink-0 mt-0.5'
                  fill='none'
                  stroke='currentColor'
                  viewBox='0 0 24 24'>
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
                  />
                </svg>
                <span
                  class='text-gray-300 text-sm leading-relaxed'
                  set:html={bullet
                    .replace('GestunByAisyah', '<strong>GestunByAisyah</strong>')
                    .replace(
                      'Bukan Pinjaman Online (Pinjol)',
                      '<strong>Bukan Pinjaman Online (Pinjol)</strong>',
                    )}
                />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
