---
import { siteContent } from '../../config/siteContent';
import SectionTitle from '../ui/SectionTitle.astro';
---

<section
  id='mengapa-memilih'
  class='py-20 bg-white'>
  <div class='max-w-7xl mx-auto px-6 text-center'>
    <SectionTitle
      subtitle={siteContent.mengapa.subtitle}
      title='Solusi Keuangan Terpercaya'
    />
    <p class='text-muted max-w-2xl mx-auto mb-16 text-lg'>
      {siteContent.mengapa.description}
    </p>

    <div class='grid md:grid-cols-3 gap-8'>
      {
        siteContent.mengapa.items.map((item, index) => (
          <article class='bg-background rounded-2xl p-8 border border-gray-100 shadow-sm hover:shadow-xl transition-shadow text-left'>
            <div class='w-14 h-14 bg-primary/10 text-primary rounded-xl flex items-center justify-center mb-6 text-2xl font-black'>
              0{index + 1}
            </div>
            <h3 class='text-xl font-bold text-tertiary mb-3'>{item.title}</h3>
            <p class='text-muted leading-relaxed'>{item.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
