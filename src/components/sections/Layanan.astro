---
import { siteContent } from '../../config/siteContent';
import { Image } from 'astro:assets';
import SectionTitle from '../ui/SectionTitle.astro';
import Button from '../ui/Button.astro';

// Mapping nama file logo sesuai dengan urutan platform di siteContent.ts
// Pastikan Anda menaruh file gambar dengan nama ini di folder public/assets/logos/
const logoFiles = [
  'spaylater.webp',
  'kredivo.webp',
  'gopay.webp',
  'blibli paylater.webp',
  'indodana.webp',
  'cc.webp', // Logo untuk Kartu Kredit (bisa gabungan logo Visa/Mastercard)
];
---

<section
  id='layanan'
  class='py-20 bg-background'>
  <div class='max-w-7xl mx-auto px-6'>
    <div class='text-center mb-16'>
      <SectionTitle
        subtitle={siteContent.layanan.subtitle}
        title={siteContent.layanan.title}
      />
      <p class='text-muted max-w-2xl mx-auto text-lg'>
        {siteContent.layanan.description}
      </p>
    </div>

    <div class='grid md:grid-cols-2 gap-8 mb-24'>
      {
        siteContent.layanan.types.map((type) => (
          <div class='bg-white rounded-2xl p-8 flex flex-col justify-between border border-gray-100 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:border-primary/30 transition-colors'>
            <div>
              <h3 class='text-2xl font-bold text-tertiary mb-6'>
                {type.name}
              </h3>
              <ul class='flex flex-col gap-4 mb-8'>
                {type.benefits.map((benefit) => (
                  <li class='flex items-center gap-3 text-gray-600'>
                    <div class='w-6 h-6 rounded-full bg-green-100 text-green-600 flex items-center justify-center shrink-0'>
                      <svg
                        class='w-4 h-4'
                        fill='none'
                        stroke='currentColor'
                        viewBox='0 0 24 24'>
                        <path
                          stroke-linecap='round'
                          stroke-linejoin='round'
                          stroke-width='2.5'
                          d='M5 13l4 4L19 7'
                        />
                      </svg>
                    </div>
                    <span class='font-medium text-sm'>{benefit}</span>
                  </li>
                ))}
              </ul>
            </div>
            <Button
              text={`Pilih ${type.name}`}
              variant='outline'
            />
          </div>
        ))
      }
    </div>

    <div class='text-center mb-12'>
      <h3 class='text-3xl md:text-4xl font-extrabold text-tertiary mb-4'>
        {siteContent.layanan.onlineServicesTitle}
      </h3>
      <p class='text-gray-500 max-w-3xl mx-auto text-base leading-relaxed'>
        {siteContent.layanan.onlineServicesDesc}
      </p>
    </div>

    <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6'>
      {
        siteContent.layanan.platforms.map((platform, index) => (
          <article class='bg-white p-8 rounded-[20px] border border-gray-100 shadow-[0_2px_15px_rgba(0,0,0,0.02)] hover:shadow-[0_10px_30px_rgba(0,0,0,0.06)] hover:-translate-y-1 transition-all duration-300 flex flex-col text-left'>
            <div class='h-10 mb-6 flex items-center justify-start'>
              <Image
                src={`/assets/${logoFiles[index]}`}
                alt={`Logo ${platform.name}`}
                width={120}
                height={40}
                format='webp'
                class='max-h-full w-auto object-contain'
              />
            </div>

            <h4 class='text-lg font-bold text-tertiary mb-3'>
              {platform.name}
            </h4>
            <p class='text-sm text-gray-500 leading-relaxed font-medium'>
              {platform.desc}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
