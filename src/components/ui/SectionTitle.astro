---
interface Props {
  subtitle: string;
  title: string;
  align?: 'left' | 'center';
  variant?: 'light' | 'dark';
}

const { subtitle, title, align = 'center', variant = 'dark' } = Astro.props;
---

<div
  class={`flex flex-col gap-2 mb-10 ${align === 'center' ? 'items-center text-center' : 'items-start text-left'}`}>
  <span
    class='text-primary font-bold tracking-wider text-sm uppercase px-3 py-1 bg-secondary rounded-full'>
    {subtitle}
  </span>
  <h2
    class={`text-3xl md:text-4xl font-extrabold ${variant === 'dark' ? 'text-text' : 'text-white'}`}>
    {title}
  </h2>
</div>
