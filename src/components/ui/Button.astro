---
import { siteContent } from '../../config/siteContent';

interface Props {
  text: string;
  variant?: 'primary' | 'outline' | 'full';
  href?: string;
  isWa?: boolean;
}

const { text, variant = 'primary', href, isWa = true } = Astro.props;

const waMsg = encodeURIComponent(siteContent.contact.defaultMessage);
const defaultWaHref = `${siteContent.contact.whatsappLink}${siteContent.contact.phone}?text=${waMsg}`;
const finalHref = isWa ? defaultWaHref : href;

const baseClass =
  'inline-flex items-center justify-center px-8 py-4 rounded-xl font-bold transition-all gap-2';
const variants = {
  primary:
    'bg-primary text-white shadow-lg shadow-primary/30 hover:bg-primary/90',
  outline: 'bg-white border-2 border-primary text-primary hover:bg-secondary',
  full: 'w-full bg-primary text-white shadow-lg shadow-primary/30 hover:bg-primary/90',
};
---

<a
  href={finalHref}
  aria-label={text}
  class={`${baseClass} ${variants[variant]}`}>
  {text}
</a>
