---
import { siteContent } from '../../config/siteContent';

const waMsg = encodeURIComponent(siteContent.contact.defaultMessage);
const waLink = `${siteContent.contact.whatsappLink}${siteContent.contact.phone}?text=${waMsg}`;

// Definisi SVG Icons untuk masing-masing step agar *self-contained* dan rapi
const stepIcons = [
  // Icon 1: Hubungi Admin (Chat)
  'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
  // Icon 2: Konsultasi Limit (Calculator)
  'M9 7h6m0 10v-3m-3 3v-3m-3 3v-3m9-5a2 2 0 00-2-2H6a2 2 0 00-2 2v14a2 2 0 002 2h12a2 2 0 002-2V7z',
  // Icon 3: Proses Transaksi (Cart)
  'M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z',
  // Icon 4: Dana Cair (Money/Payment)
  'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
];
---

<section
  id='cara-order'
  class='py-24 bg-white'>
  <div class='max-w-7xl mx-auto px-6 text-center'>
    <div class='mb-16'>
      <span
        class='text-primary font-bold text-[11px] tracking-[0.15em] uppercase block mb-3'>
        {siteContent.langkah.subtitle}
      </span>
      <h2 class='text-3xl md:text-4xl font-extrabold text-tertiary mb-4'>
        {siteContent.langkah.title}
      </h2>
      <p class='text-gray-500 max-w-2xl mx-auto text-[15px] leading-relaxed'>
        {siteContent.langkah.description}
      </p>
    </div>

    <div class='relative grid grid-cols-1 md:grid-cols-4 gap-12 md:gap-6 mb-16'>
      <div
        class='hidden md:block absolute top-[45px] left-[12.5%] right-[12.5%] h-[1px] bg-gray-200 z-0'>
      </div>

      {
        siteContent.langkah.steps.map((step, index) => {
          // Logika warna untuk badge angka (3 langkah awal orange, langkah terakhir navy)
          const isLast = index === siteContent.langkah.steps.length - 1;
          const badgeColor = isLast ? 'bg-tertiary' : 'bg-primary';

          return (
            <div class='flex flex-col items-center text-center relative z-10 group'>
              <div class='relative w-[90px] h-[90px] bg-background border-2 border-gray-100 rounded-full flex items-center justify-center shadow-sm group-hover:border-primary/20 group-hover:shadow-md transition-all duration-300'>
                <svg
                  class='w-8 h-8 text-gray-400 group-hover:text-primary transition-colors'
                  fill='none'
                  stroke='currentColor'
                  viewBox='0 0 24 24'>
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='1.5'
                    d={stepIcons[index]}
                  />
                </svg>

                <div
                  class={`absolute top-0 right-0 translate-x-1/4 -translate-y-1/4 w-7 h-7 rounded-full flex items-center justify-center text-white text-xs font-bold shadow-sm ${badgeColor}`}>
                  {index + 1}
                </div>
              </div>

              <h3 class='text-lg font-bold text-tertiary mt-6 mb-3'>
                {step.title}
              </h3>
              <p class='text-[14px] text-gray-500 leading-relaxed px-2'>
                {step.desc}
              </p>
            </div>
          );
        })
      }
    </div>

    <a
      href={waLink}
      class='inline-flex items-center justify-center gap-2 text-tertiary font-bold text-sm hover:text-primary transition-colors group'>
      {siteContent.langkah.cta}
      <svg
        class='w-4 h-4 group-hover:translate-x-1 transition-transform'
        fill='none'
        stroke='currentColor'
        viewBox='0 0 24 24'>
        <path
          stroke-linecap='round'
          stroke-linejoin='round'
          stroke-width='2'
          d='M14 5l7 7m0 0l-7 7m7-7H3'
        ></path>
      </svg>
    </a>
  </div>
</section>
